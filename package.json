{
  "name": "pi-suite",
  "version": "0.1.0",
  "description": "A small, self-consistent, agent-facing extension suite for Pi: browser, git, goal, lens, memory, spawn, todo.",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./memory/index.ts",
      "./todo/index.ts",
      "./goal/index.ts",
      "./git/index.ts",
      "./spawn/index.ts",
      "./browser/index.ts",
      "./telegram/index.ts",
      "./lens/index.ts"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke": "./scripts/smoke-install.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
